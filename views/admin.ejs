<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="admin-main">
    <h1>Admin Dashboard</h1>
    <p>Welcome, Administrator. Here is an overview of your platform's data.</p>

    <!-- Users Section -->
    <section class="admin-section">
        <h2>Registered Users (<%= users.length %>)</h2>
        <% if (users.length === 0) { %>
            <p>No users registered yet.</p>
        <% } else { %>
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>Address</th>
                    </tr>
                </thead>
                <tbody>
                    <% users.forEach(user => { %>
                        <tr>
                            <td><%= user.id %></td>
                            <td><%= user.fullName %></td>
                            <td><%= user.email %></td>
                            <td><%= user.address %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        <% } %>
    </section>

    <!-- Products & Inventory Section -->
    <section class="admin-section">
        <h2>Product Catalog & Inventory (<%= products.length %>)</h2>
        <table class="admin-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Size</th>
                    <th>Price</th>
                    <th>Stock</th>
                </tr>
            </thead>
            <tbody>
                <% products.forEach(product => { %>
                    <tr>
                        <td><%= product.id %></td>
                        <td><%= product.title %></td>
                        <td><%= product.category %></td>
                        <td><%= product.volumeSize %></td>
                        <td>$<%= product.price.toFixed(2) %></td>
                        <td><%= product.stockQuantity %> units</td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </section>

    <!-- All Orders Section -->
    <section class="admin-section">
        <h2>All Platform Orders (<%= orders.length %>)</h2>
        <% if (orders.length === 0) { %>
            <p>No orders placed yet.</p>
        <% } else { %>
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Order ID</th>
                        <th>User ID</th>
                        <th>Item</th>
                        <th>Qty</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    <% orders.forEach(order => { %>
                        <tr>
                            <td>#<%= order.orderId %></td>
                            <td><%= order.userId %></td>
                            <td><%= order.productItems.title %></td>
                            <td><%= order.productItems.quantity %></td>
                            <td>$<%= order.totalAmount %></td>
                            <td><%= order.paymentStatus %></td>
                            <td><%= order.orderDate.toLocaleDateString() %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        <% } %>
    </section>

    <!-- Delivery & Fulfillment Section -->
    <section class="admin-section">
        <h2>Delivery & Fulfillment Tracking</h2>
        <% if (deliveries.length === 0) { %>
            <p>No deliveries tracked yet.</p>
        <% } else { %>
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Delivery ID</th>
                        <th>Order ID</th>
                        <th>Shipping Address</th>
                        <th>Estimated Delivery</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <% deliveries.forEach(delivery => { %>
                        <tr>
                            <td>#<%= delivery.deliveryId %></td>
                            <td>#<%= delivery.orderId %></td>
                            <td><%= delivery.shippingAddress %></td>
                            <td><%= delivery.deliveryDate.toLocaleDateString() %></td>
                            <td><strong><%= delivery.carrierStatus %></strong></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        <% } %>
    </section>
</main>

<%- include('partials/footer') %>