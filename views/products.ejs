<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class = "products-main">
    <h1>Our Refreshing Products</h1>
    <p>Explore our range of high-quality water products:</p>

    <div class="product-grid">
        <% products.forEach(product => {%>
            <div class="product-item">
                <h2><%= product.title %></h2>
                <p><strong>Category:</strong><%= product.category %></p>
                <p><strong>Size:</strong><%= product.volumeSize %></p>
                <p><strong>Price:</strong> $<%= product.price.toFixed(2) %></p>
                <p><strong>In Stock:</strong> <%= product.stockQuantity %> units</p>
                <img src="/images/<%= product.image %>" alt="<%= product.title %> Image" width="300" height="200">

                <form action="/checkout" method="POST" class="order-form">
                    <input type="hidden" name="productId" value="<%= product.id %>">
                    <label for="quantity-<%= product.id %>">Quantity:</label>
                    <input type="number" id="quantity-<%=product.id%>"" name ="quantity" value="1" min="1" max="<%= product.stockQuantity %>" required>
                    <button type="submit">Place Order</button>
                </form>
            </div>
        <% }) %>
    </div>

</main>

<%- include('partials/footer') %>